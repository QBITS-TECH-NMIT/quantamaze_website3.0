 // ANIMATION VARIANTS
 // ─────────────────────────────────────────────────────────────────
 
+// ─────────────────────────────────────────────────────────────────
+// LIVE ROSTER (Supabase, managed from /admin/members)
+// Falls back to the generated static roster above if the fetch fails
+// or the table is empty.
+// ─────────────────────────────────────────────────────────────────
+
+function rowToMember(row) {
+  return {
+    name: row.name,
+    role: row.role,
+    code: row.code || undefined,
+    photo: row.photo_url || null,
+    photoUrl: row.photo_url || null,
+    isHead: row.is_head || undefined,
+    isTopLeadership: row.is_top_leadership || undefined,
+    imagePosition: row.image_position || undefined,
+  };
+}
+
+function buildLiveRoster(rows) {
+  if (!Array.isArray(rows) || rows.length === 0) return null;
+  const byGroup = (id) => rows.filter((row) => row.group_id === id).map(rowToMember);
+  const domains = DOMAINS_DATA
+    .map((domain) => ({ ...domain, members: byGroup(domain.id) }))
+    .filter((domain) => domain.members.length > 0);
+  return { faculty: byGroup("faculty"), leadership: byGroup("leadership"), domains };
+}
+
+function useLiveRoster() {
+  const [state, setState] = useState({ status: "loading", roster: null });
+
+  useEffect(() => {
+    let active = true;
+    fetch("/api/members")
+      .then((response) => (response.ok ? response.json() : Promise.reject(new Error("members request failed"))))
+      .then((data) => {
+        if (!active) return;
+        const roster = buildLiveRoster(data.members);
+        setState({ status: roster ? "ready" : "fallback", roster });
+      })
+      .catch(() => {
+        if (active) setState({ status: "fallback", roster: null });
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+
+  return state;
+}
+
